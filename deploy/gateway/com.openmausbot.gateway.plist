<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmausbot.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--experimental-strip-types</string>
    <string>scripts/gateway-daemon.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/latiao/OpenMausBot</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>StandardOutPath</key>
  <string>/tmp/openmausbot-gateway.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/openmausbot-gateway.err.log</string>
</dict>
</plist>
